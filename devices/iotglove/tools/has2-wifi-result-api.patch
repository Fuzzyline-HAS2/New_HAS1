+#include "HAS2_Wifi.h"
+
+// Additive first_store API. Legacy device methods and reconnect policy are unchanged.
+namespace {
+String encodeQuery(const String &value) {
+  static const char hex[] = "0123456789ABCDEF";
+  String encoded;
+  encoded.reserve(value.length() * 3);
+  for (size_t i = 0; i < value.length(); ++i) {
+    const uint8_t c = static_cast<uint8_t>(value[i]);
+    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+        (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.') encoded += char(c);
+    else { encoded += '%'; encoded += hex[c >> 4]; encoded += hex[c & 15]; }
+  }
+  return encoded;
+}
+}
+
+bool HAS2_Wifi::TrySetup(String theme) {
+  if (theme != "badland" && theme != "city") return false;
+  _theme = theme;
+  HOST_NAME = (_theme == "city") ? "http://172.30.1.44" : "http://172.30.1.43";
+  server = HOST_NAME + PHP_FILE_NAME;
+  WiFi.mode(WIFI_STA);
+  my_mac = WiFi.macAddress();
+  // A worker owns Wi-Fi/HTTP. Failure is returned instead of rebooting the board.
+  return WiFi.status() == WL_CONNECTED || TryConnectSaved() || TryConnectOrdered();
+}
+
+bool HAS2_Wifi::HttpRequestChecked(String request, String url) {
+  const uint32_t started = millis();
+  lastHttpResult_ = HAS2HttpResult{};
+  String payload;
+  // Complete fires after the final JSON outcome is visible to the worker.
+  struct Completion {
+    HAS2HttpResult &result; uint32_t started; HAS2HttpProgressHook hook; void *context;
+    ~Completion() { result.elapsedMs = uint32_t(millis() - started); if (hook) hook(HAS2HttpPhase::Complete, result.bytes, context); }
+  } completion{lastHttpResult_, started, boundedHttp_ ? httpProgressHook_ : nullptr, httpProgressContext_};
+  if (WiFi.status() != WL_CONNECTED) { lastHttpResult_.error = HAS2HttpError::Transport; return false; }
+  if (boundedHttp_) {
+    if (!boundedHttp_(url, payload, lastHttpResult_, httpProgressHook_, httpProgressContext_)) return false;
+  } else {
+    HTTPClient client;
+    client.setConnectTimeout(1500);
+    client.setTimeout(1500);
+    if (!client.begin(url)) { lastHttpResult_.error = HAS2HttpError::Transport; return false; }
+    const int code = client.GET();
+    lastHttpResult_.status = code;
+    if (code != HTTP_CODE_OK || client.getSize() > 8192) {
+      client.end(); lastHttpResult_.error = code <= 0 ? HAS2HttpError::Transport : HAS2HttpError::HttpStatus; return false;
+    }
+    payload = client.getString(); client.end();
+    lastHttpResult_.bytes = payload.length();
+    if (payload.length() > 8192) { lastHttpResult_.error = HAS2HttpError::TooLarge; return false; }
+  }
+  // A transport ACK is not proof that a game mutation was applied: callers re-read.
+  if (request == "Send") return true;
+  StaticJsonDocument<4096> parsed;
+  if (deserializeJson(parsed, payload) || !parsed.is<JsonObject>() ||
+      parsed["error"].is<const char *>() || parsed.overflowed()) { lastHttpResult_.error = HAS2HttpError::Json; return false; }
+  if (request == "ReceiveMine") {
+    my.clear(); my.set(parsed);
+    if (my.overflowed()) { lastHttpResult_.error = HAS2HttpError::Json; return false; }
+    return true;
+  }
+  if (request == "Receive") {
+    tag.clear(); tag.set(parsed);
+    if (tag.overflowed()) { lastHttpResult_.error = HAS2HttpError::Json; return false; }
+    return true;
+  }
+  if (request == "Loop") {
+    shift_machine.clear(); shift_machine.set(parsed);
+    if (shift_machine.overflowed()) { lastHttpResult_.error = HAS2HttpError::Json; return false; }
+    return true;
+  }
+  return false;
+}
+
+bool HAS2_Wifi::ReceiveMineChecked() {
+  my.clear();
+  return HttpRequestChecked("ReceiveMine", server + "?request=ReceiveMine&table=device&mac=" + encodeQuery(my_mac));
+}
+
+bool HAS2_Wifi::ReceiveChecked(String name) {
+  tag.clear();
+  return HttpRequestChecked("Receive", server + "?request=Receive&table=device&key=" + encodeQuery(name));
+}
+
+bool HAS2_Wifi::LoopChecked() {
+  shift_machine.clear();
+  return HttpRequestChecked("Loop", server + "?request=Loop&table=device&mac=" + encodeQuery(my_mac));
+}
+
+bool HAS2_Wifi::SendChecked(String name, String column, String value) {
+  return HttpRequestChecked("Send", server + "?request=Send&table=device&key=" + encodeQuery(name) +
+                           "&column=" + encodeQuery(column) + "&value=" + encodeQuery(value));
+}
+
+bool HAS2_Wifi::SetGloveChipChecked(String name, bool present) {
+  return HttpRequestChecked("Send", server + "?request=SetGloveChip&mac=" + encodeQuery(my_mac) +
+                           "&key=" + encodeQuery(name) + "&value=" + (present ? "1" : "0"));
+}
